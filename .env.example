DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aque_db

JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Necessário em dev: o proxy do Angular (aque-web) usa changeOrigin, então o backend vê
# Host e Origin diferentes e trata a requisição como cross-origin de verdade. Sem isso,
# login via o proxy de dev falha com 403 (ver aque-backend/CLAUDE.md — seção CORS).
CORS_ALLOWED_ORIGINS=http://localhost:4200